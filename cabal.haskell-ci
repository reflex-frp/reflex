-- Settings for haskell-ci (https://github.com/haskell-CI/haskell-ci).  After a
-- change to this file or to tested-with in reflex.cabal, run
--
--   haskell-ci regenerate
--
-- to update .github/workflows/haskell-ci.yml.

distribution: noble

-- Do not constrain the packages that come with GHC to their installed versions.
installed: -all
unconstrained: False

constraint-set old-these
  ghc: <8.8
  constraints: these <1

constraint-set debug-propagation
  constraints: reflex +debug-propagation

constraint-set debug-cycles
  constraints: reflex +debug-cycles
